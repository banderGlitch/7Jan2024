        "import pytz\n",
        "import tzlocal\n",
        "\n",
        "# Patch tzlocal.get_localzone to return a pytz timezone (UTC in this example)\n",
        "tzlocal.get_localzone = lambda: pytz.timezone('UTC')\n",
        "\n",
        "from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup\n",
        "from telegram.ext import ApplicationBuilder, CommandHandler, CallbackQueryHandler, CallbackContext, ContextTypes\n",
        "import asyncio\n",
        "from bleak import BleakClient\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.animation import FuncAnimation\n",
        "import threading\n",
        "import nest_asyncio  # Import nest_asyncio\n",
        "import logging\n",
        "\n",
        "# Apply nest_asyncio to allow nested event loops\n",
        "nest_asyncio.apply()\n",
        "\n",
        "# 7820249480:AAEoH7GPL8hQ1gkbf_A7mWmyHkgu2Eb2WoE\n",
        "# telegram bot token\n",
        "\n",
        "# Bluetooth Configuration\n",
        "DEVICE_ADDRESS = 'C4:AC:AA:EE:5F:25'  # Replace with your Bluetooth device address\n",
        "SERVICE_UUID = 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'  # Replace with your service UUID\n",
        "START_COMMAND = b'start'\n",
        "STOP_COMMAND = b'stop'\n",
        "\n",
        "# Global Variables\n",
        "left_sensor_data = []\n",
        "right_sensor_data = []\n",
        "running = False\n",
        "\n",
        "# Bluetooth Functions\n",
        "async def send_bluetooth_command(command: bytes):\n",
        "    async with BleakClient(DEVICE_ADDRESS) as client:\n",
        "        await client.write_gatt_char(SERVICE_UUID, command)\n",
        "\n",
        "# Graph Plotting\n",
        "fig, ax = plt.subplots()\n",
        "\n",
        "# Initialize the plot lines\n",
        "left_line, = ax.plot([], [], label='Left Sensor')\n",
        "right_line, = ax.plot([], [], label='Right Sensor')\n",
        "ax.legend()\n",
        "\n",
        "def init():\n",
        "    ax.set_xlim(0, 100)\n",
        "    ax.set_ylim(0, 100)\n",
        "    return left_line, right_line\n",
        "\n",
        "def update(frame):\n",
        "    if len(left_sensor_data) > 100:\n",
        "        left_sensor_data.pop(0)\n",
        "        right_sensor_data.pop(0)\n",
        "    left_line.set_data(range(len(left_sensor_data)), left_sensor_data)\n",
        "    right_line.set_data(range(len(right_sensor_data)), right_sensor_data)\n",
        "    return left_line, right_line\n",
        "\n",
        "def start_plotting():\n",
        "    ani = FuncAnimation(fig, update, init_func=init, blit=True, interval=1000)\n",
        "    plt.show()\n",
        "\n",
        "# Telegram Bot Functions\n",
        "async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:\n",
        "    \"\"\"Sends a message with three inline buttons attached.\"\"\"\n",
        "    keyboard = [\n",
        "        [InlineKeyboardButton(\"Start\", callback_data='start')],\n",
        "        [InlineKeyboardButton(\"Stop\", callback_data='stop')]\n",
        "    ]\n",
        "    reply_markup = InlineKeyboardMarkup(keyboard)\n",
        "    await update.message.reply_text('Control Panel:', reply_markup=reply_markup)\n",
        "\n",
        "async def button(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:\n",
        "    \"\"\"Parses the CallbackQuery and updates the message text.\"\"\"\n",
        "    global running\n",
        "    query = update.callback_query\n",
        "\n",
        "    if query is not None:  # Check if query is not None\n",
        "        await query.answer()\n",
        "\n",
        "        if query.data == 'start':\n",
        "            running = True\n",
        "            await send_bluetooth_command(START_COMMAND)\n",
        "            if query.message is not None:\n",
        "                await query.edit_message_text(text=\"Started\")\n",
        "            else:\n",
        "                logging.warning(\"query.message is None\")\n",
        "        elif query.data == 'stop':\n",
        "            running = False\n",
        "            await send_bluetooth_command(STOP_COMMAND)\n",
        "            if query.message is not None:\n",
        "                await query.edit_message_text(text=\"Stopped\")\n",
        "            else:\n",
        "                logging.warning(\"query.message is None\")\n",
        "    else:\n",
        "        logging.warning(\"update.callback_query is None\")  # Log if query is None\n",
        "\n",
        "\n",
        "\n",
        "# Background Task to Simulate Data (Replace with actual Bluetooth data reading)\n",
        "def sensor_data_simulation():\n",
        "    import random\n",
        "    import time  # Use time.sleep for synchronous sleeping\n",
        "    while True:\n",
        "        if running:\n",
        "            left_sensor_data.append(random.randint(0, 100))\n",
        "            right_sensor_data.append(random.randint(0, 100))\n",
        "        time.sleep(1)\n",
        "\n",
        "# Main Function\n",
        "def main():\n",
        "    # Telegram Bot Setup\n",
        "    application = ApplicationBuilder().token(\"7820249480:AAEoH7GPL8hQ1gkbf_A7mWmyHkgu2Eb2WoE\").build()\n",
        "\n",
        "    # Add handlers\n",
        "    application.add_handler(CommandHandler(\"start\", start))\n",
        "    application.add_handler(CallbackQueryHandler(button))\n",
        "\n",
        "    # Start the sensor data simulation and plotting in separate threads\n",
        "    threading.Thread(target=sensor_data_simulation, daemon=True).start()\n",
        "    threading.Thread(target=start_plotting, daemon=True).start()\n",
        "\n",
        "    # Start the Bot\n",
        "    application.run_polling()\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    main()\n"
      ]
